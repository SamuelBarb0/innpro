<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Base de pruebas APARTE. Estaba comentado, y con estas dos líneas
            fuera `php artisan test` corría contra la base de DESARROLLO: como
            las pruebas usan RefreshDatabase, cada corrida la reconstruía desde
            cero y se llevaba por delante los datos locales.

            No se usa sqlite en memoria —que sería lo típico— porque el proyecto
            tiene SQL propio de MySQL (`->change()` con SQL crudo en varias
            migraciones y `FIELD()` en algunos ordenamientos) que sqlite no
            entiende: las pruebas fallarían por el motor, no por el código.

            Crear la base una vez:
              CREATE DATABASE portfolio_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <env name="DB_DATABASE" value="portfolio_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
